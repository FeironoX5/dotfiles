{
    "layer": "top",
    "position": "left",        // changed: top → left
    "margin-left": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "spacing": 6,

    // In vertical mode: modules-left = top, modules-center = middle, modules-right = bottom
    "modules-left": ["niri/workspaces", "niri/window"],

    "modules-center": ["custom/codeforces", "custom/lichess"],

    "modules-right": [
        "tray",
        "custom/vpn",
        "custom/wifi",
        "bluetooth",
        "niri/language",
        "pulseaudio",
        "battery",
        "custom/notification",
        "clock",
    ],

    "custom/vpn": {
        "signal": 8,
        "format": "◉ {}",
        "exec": "~/.dotfiles/scripts/vpn.bash waybar",
        "return-type": "json",
        "on-click": "~/.dotfiles/scripts/vpn.bash waybar-toggle",
        "interval": 3,
        "rotate": 270,
    },

    "custom/letterboxd": {
        "interval": 3600,
        "format": "&#xEF7E; {}",
        "return-type": "text",
        "exec": "python3 $HOME/scripts/letterboxd.py",
        "tooltip": false,
        "signal": 15,
        "rotate": 270,
    },

    "custom/codeforces": {
        "interval": 3600,
        "format": "&#xF1CE; {}",
        "return-type": "text",
        "exec": "python3 $HOME/scripts/codeforces.py",
        "tooltip": false,
        "signal": 15,
        "rotate": 270,          // rotated for vertical bar
    },

    "custom/lichess": {
        "interval": 3600,
        "format": "&#xF5E1; {}",
        "return-type": "text",
        "exec": "python3 $HOME/scripts/lichess.py",
        "tooltip": false,
        "signal": 15,
        "rotate": 270,          // rotated for vertical bar
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6,
    },

    "pulseaudio": {
        "scroll-step": 0.5,
        "format": "&#xF2A1; {volume}%",
        "format-muted": "&#xF2A0;",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": true,
        "max-volume": 160,
        "rotate": 270,          // rotated for vertical bar
    },

    "battery": {
        "interval": 1,
        "states": {
            "good": 99,
            "warning": 25,
        },
        "format": "&#xEAAF; {capacity}%",
        "format-warning": "&#xEAB1; {capacity}%",
        "format-charging": "&#xEAAD; {capacity}%",
        "tooltip": true,
        "tooltip-format": "{capacity}%",
        "rotate": 270,          // rotated for vertical bar
    },

    "niri/workspaces": {
        "format": "{icon}",     // icon-only keeps buttons compact on a narrow bar
        "format-icons": {
            "active": "&#xF192;",
            "default": "&#xF111;",
            "anchor": "&#x2693;",
            "anchor-active": "&#x2693;",
        }
    },

    "niri/window": {
        "format": "{title}",
        "rotate": 270,          // title runs vertically along the bar
        "max-length": 30,
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1 1>/dev/null",
        "on-scroll-down": "hyprctl dispatch workspace e-1 1>/dev/null",
        "sort-by-number": true,
        "active-only": false,
    },
    "hyprland/window": {
        "format": "{title}",
        "separate-outputs": true,
        "rotate": 270,
        "rewrite": {
            "(.*) — Mozilla Firefox": "🔍 $1",
            "(.*) — Zen Browser": "🔍 $1",
            "(.*) - Chromium": "🔍 $1",
            "(.*) - Visual Studio Code": "▄▀ $1 ▀▄",
            "(.*) - Obsidian(.*)": "🧠 $1",
        },
    },

    "clock": {
        // Shortened format — long dates look bad rotated; use tooltip for full date
        "format": "{:%H:%M}",
        "format-alt": "{:%a %e %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "rotate": 270,          // time reads upward along the left edge
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "<span color='#cdd6f4'><b>{}</b></span>",
                "days":     "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks":    "<span color='#cdd6f4'><b>W{}</b></span>",
                "weekdays": "<span color='#cdd6f4'><b>{}</b></span>",
                "today":    "<span color='#f38ba8'><b>{}</b></span>",
            },
        },
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
    },

    "niri/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "rotate": 270,
    },

    "custom/wifi": {
        "exec": "~/scripts/wifi-status.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "~/scripts/wifi-menu.sh",
        "interval": 1,
        "rotate": 270,
    },

    "bluetooth": {
        "format": "&#xEACC;",
        "format-disabled": "&#xEACC;",
        "format-connected": "&#xEAC9;",
        "tooltip-format": "{num_connections} connected",
        "tooltip-format-disabled": "Bluetooth Disabled",
        "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}%",
        "on-click": "~/scripts/bluetooth-menu.sh",
        "interval": 1,
    },

    "custom/notification": {
        "tooltip": false,
        "rotate": 0,
        "format": "{icon}",
        "format-icons": {
            "notification": "&#xEF93; ",
            "dnd-notification": "&#xF58E; ",
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click-right": "swaync-client -d -sw",
        "on-click": "swaync-client -t -sw",
        "escape": true,
    },
}
